{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "fixtures/**/*.ts",
    "global-setup.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}
