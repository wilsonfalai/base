{
  "name": "@base-app/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm db:generate",
    "build": "tsc --project tsconfig.json",
    "dev": "prisma studio --port 5555 --browser none",
    "typecheck": "pnpm db:generate && tsc --project tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:prisma",
    "@prisma/client": "catalog:prisma",
    "dotenv": "18.0.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "prisma": "catalog:prisma",
    "typescript": "6.0.3"
  }
}
