{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "E2E_API_BASE_URL",
    "E2E_BASE_URL",
    "E2E_USER_EMAIL",
    "E2E_USER_NAME",
    "E2E_USER_PASSWORD",
    "NODE_ENV",
    "PORT",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": { "cache": false, "persistent": true },
    "db:generate": {
      "cache": true,
      "env": ["DATABASE_URL"],
      "outputs": ["src/generated/prisma/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@base-app/database#typecheck": {
      "dependsOn": ["@base-app/database#build"]
    },
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
