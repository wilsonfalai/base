{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL", "NODE_ENV", "PORT"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": { "cache": false, "persistent": true },
    "db:generate": {
      "cache": true,
      "env": ["DATABASE_URL"],
      "outputs": ["src/generated/prisma/**"]
    },
    "lint": {},
    "test": {},
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {}
  }
}
